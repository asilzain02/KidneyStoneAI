# ═══════════════════════════════════════════════════════════════
# .gitignore — KidneyStoneAI Project
# Covers: Java/Maven, Python, Node/React, Docker, Secrets, OS
# ═══════════════════════════════════════════════════════════════

# ─── SECRETS / ENVIRONMENT ──────────────────────────────────────
.env
.env.*
!.env.example
*.secret
secrets/

# ─── JAVA / MAVEN ───────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.classpath
.project
.settings/
.factorypath
*.iml
*.ipr
*.iws
.idea/

# ─── SPRING BOOT ────────────────────────────────────────────────
spring-boot-devtools.properties
application-prod.yml
application-staging.yml

# ─── PYTHON ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/
*.egg
*.spec

# ─── AI MODEL WEIGHTS (large binary files) ──────────────────────
ai-engine/weights/*.pt
ai-engine/weights/*.pth
ai-engine/weights/*.pkl
ai-engine/weights/*.onnx
ai-engine/weights/*.h5
ai-engine/weights/*.ckpt
# Use Git LFS or external storage for weights

# ─── DATASETS (large data) ──────────────────────────────────────
datasets/raw/
datasets/processed/
datasets/train/
datasets/validation/
datasets/test/
datasets/manifests/
datasets/splits/
*.tif
# Keep only metadata and README
!datasets/metadata/
!datasets/README.md
!datasets/clinical_data/.gitkeep

# ─── NODE / REACT ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.next/
.cache/
*.log
.DS_Store
.eslintcache
coverage/

# ─── DOCKER ─────────────────────────────────────────────────────
docker-compose.override.yml

# ─── UPLOADS (runtime image storage) ────────────────────────────
backend/image-service/uploads/
!backend/image-service/uploads/.gitkeep

# ─── LOGS ───────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── COMPILED / GENERATED ───────────────────────────────────────
*.class
*.swp
*.swo
*~
.classpath

# ─── OPERATING SYSTEM ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── BACKUP ─────────────────────────────────────────────────────
README-copy.md
database/backup/
*.bak
*.dump

# ─── TEST COVERAGE ──────────────────────────────────────────────
testing/reports/

# ─── PYTHON VIRTUAL ENVIRONMENTS (all variants) ─────────────────
.venv-ai/
.venv*/

# ─── AI ENGINE — RUNTIME OUTPUTS ───────────────────────────────
ai-engine/outputs/
outputs/

# ─── AI MODEL WEIGHTS (subdirectory experiments) ────────────────
# Covers EXP* experiment weight folders and nested checkpoints
ai-engine/weights/EXP*/
ai-engine/weights/experiments/
ai-engine/weights/**/*.pt
ai-engine/weights/**/*.pth
ai-engine/weights/**/*.pkl
ai-engine/weights/**/*.onnx
ai-engine/weights/**/*.h5
ai-engine/weights/**/*.ckpt

# ─── ROOT-LEVEL SCRATCH / TEST OUTPUT FILES ────────────────────
# These are one-off diagnostic files, not project artifacts
/pytest_out.txt
/pytest_out2.txt
/smoke_run.txt
/smoke_test_final.txt
/smoke_test_final_utf8.txt
/smoke_test_output.txt
/test_out.txt
/test_output.txt
/test_output_utf8.txt
/verify_output.txt
/verify_output.utf8.txt
/exp01_output.txt
/mvn.log
/walkthrough_experiments.md
/implementation_plan_segmentation
*.txt


# ─── ZIP FILES ────────────────────

ai-engine.zip
frontend.zip
backend.zip